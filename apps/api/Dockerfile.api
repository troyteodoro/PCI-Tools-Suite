# syntax=docker/dockerfile:1.7
#
# API image. The worker shares this source tree but has its own Dockerfile so the
# Playwright crawl image (M2) can diverge without dragging Chromium into the API.

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# ── dependencies ────────────────────────────────────────────────────────────────
FROM base AS deps

RUN --mount=type=cache,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Only the lock, so this layer is reused until a dependency actually changes. Copying
# src first would rebuild the whole dependency tree on every edit.
#
# --require-hashes makes the build fail on a tampered or substituted artifact rather
# than installing it. The lock is generated by `make lock` and is what CI tests against,
# so the image and the test run resolve to the same versions.
COPY requirements.txt ./
RUN pip install --prefix=/install --require-hashes -r requirements.txt

# ── runtime ─────────────────────────────────────────────────────────────────────
FROM base AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 demarc

COPY --from=deps /install /usr/local

COPY --chown=demarc:demarc src ./src
COPY --chown=demarc:demarc alembic ./alembic
COPY --chown=demarc:demarc alembic.ini ./alembic.ini
COPY --chown=demarc:demarc pyproject.toml ./pyproject.toml

ENV PYTHONPATH=/app/src

USER demarc
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

# --proxy-headers so client addresses in the audit log are the real ones behind Caddy.
CMD ["uvicorn", "demarc.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
