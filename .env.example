# Copy to .env for local development. Every value here is a development default and is
# refused in production (see demarc.core.config.Settings.validate_for_production).
#
# For production, copy to .env.production and supply the sensitive values as files under
# ./secrets/ instead — see compose.prod.yml.

# ── deployment ──────────────────────────────────────────────────────────────────
DEMARC_ENVIRONMENT=local
# single_tenant | saas  — see PLAN.md §9 for exactly what this switches
DEMARC_DEPLOYMENT_MODE=single_tenant
DEMARC_SINGLE_TENANT_ORG_SLUG=default
DEMARC_LOG_LEVEL=INFO

# ── database ────────────────────────────────────────────────────────────────────
# Owner role: runs migrations only.
POSTGRES_USER=demarc
POSTGRES_PASSWORD=demarc
POSTGRES_DB=demarc
# Least-privileged runtime role, created by infra/postgres/init/01-app-role.sql.
# Not the table owner, no BYPASSRLS — this is what makes row-level security real.
DEMARC_APP_DB_PASSWORD=demarc_app

# ── object storage (MinIO locally, S3 in production) ────────────────────────────
DEMARC_S3_BUCKET=demarc-evidence
DEMARC_S3_ACCESS_KEY_ID=demarc
DEMARC_S3_SECRET_ACCESS_KEY=demarc-dev-secret

# ── application ─────────────────────────────────────────────────────────────────
# 32+ bytes. Generate with:  openssl rand -base64 48
DEMARC_SECRET_KEY=dev-only-insecure-key-do-not-use-in-production-0000
DEMARC_CORS_ORIGINS=http://localhost:5173

# ── production only ─────────────────────────────────────────────────────────────
# DEMARC_REGISTRY=ghcr.io/your-org
# DEMARC_VERSION=0.1.0
# DEMARC_PUBLIC_HOSTNAME=demarc.example.com
# DEMARC_PUBLIC_ORIGIN=https://demarc.example.com
# DEMARC_ACME_EMAIL=security@example.com
